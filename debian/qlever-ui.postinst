#!/bin/sh
set -e

case "$1" in
    configure)
        # Create system user and group if they don't exist
        if ! getent group qlever-ui > /dev/null 2>&1; then
            addgroup --system qlever-ui
        fi
        if ! getent passwd qlever-ui > /dev/null 2>&1; then
            adduser --system --ingroup qlever-ui \
                --home /var/lib/qlever-ui \
                --no-create-home \
                --shell /usr/sbin/nologin \
                --gecos "QLever UI service account" \
                qlever-ui
        fi

        # Create required directories
        install -d -m 0750 -o qlever-ui -g qlever-ui /var/log/qlever-ui
        install -d -m 0750 -o qlever-ui -g qlever-ui /var/lib/qlever-ui

        # Install seed database if not already present
        if [ ! -f /var/lib/qlever-ui/qleverui.sqlite3 ]; then
            install -m 0640 -o qlever-ui -g qlever-ui \
                /usr/share/qlever-ui/qleverui.sqlite3 \
                /var/lib/qlever-ui/qleverui.sqlite3
        fi

        # Install default env file if not already present
        if [ ! -f /etc/qlever-ui/qlever-ui.env ]; then
            install -d -m 0750 -o root -g qlever-ui /etc/qlever-ui
            install -m 0640 -o root -g qlever-ui \
                /usr/share/qlever-ui/qlever-ui.env.default \
                /etc/qlever-ui/qlever-ui.env
        fi

        ;;
esac

#DEBHELPER#
exit 0
