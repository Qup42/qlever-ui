DJANGO_SETTINGS_MODULE=qlever.settings
QLEVERUI_SECRET_KEY=change-me-on-install
QLEVERUI_DEBUG=True
QLEVERUI_ALLOWED_HOSTS=localhost
QLEVERUI_CSRF_TRUSTED_ORIGINS=http://localhost
# Overwritten during startup
QLEVERUI_DATABASE_URL=sqlite:////var/lib/qlever-ui/qleverui.sqlite3
QLEVERUI_STATIC_ROOT=/usr/share/qlever-ui/static
